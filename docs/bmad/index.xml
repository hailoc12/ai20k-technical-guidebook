&lt;h2&gt;4-Phase Workflow&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;4-phase-workflow&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#4-phase-workflow&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&lt;h3&gt;Phase 1: Analysis&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;phase-1-analysis&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#phase-1-analysis&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h3&gt;&lt;ul&gt;
&lt;li&gt;Brainstorming, research, product briefs&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Phase 2: Planning&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;phase-2-planning&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#phase-2-planning&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h3&gt;&lt;ul&gt;
&lt;li&gt;PRD creation, UX design&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Phase 3: Solutioning&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;phase-3-solutioning&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#phase-3-solutioning&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h3&gt;&lt;ul&gt;
&lt;li&gt;Architecture, ADRs, epic/story breakdown&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Phase 4: Implementation&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;phase-4-implementation&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#phase-4-implementation&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h3&gt;&lt;ul&gt;
&lt;li&gt;Sprint planning, story implementation, code review&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;Folder Structure&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;folder-structure&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#folder-structure&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&lt;div class=&#34;hextra-code-block hx:relative hx:mt-6 hx:first:mt-0 hx:group/code&#34;&gt;

&lt;div&gt;&lt;pre&gt;&lt;code&gt;project/
├── _bmad/                    ← BMAD core
│   ├── _config/              ← Config
│   ├── bmm/                  ← Module config
│   ├── custom/               ← Customizations
│   └── scripts/              ← Helper scripts
├── _bmad-output/             ← Output
│   ├── planning-artifacts/   ← Phase 1-3
│   └── implementation-artifacts/ ← Phase 4
├── docs/                     ← Documentation
└── src/                      ← Source code&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;div class=&#34;hextra-code-copy-btn-container hx:opacity-0 hx:transition hx:group-hover/code:opacity-100 hx:flex hx:gap-1 hx:absolute hx:m-[11px] hx:right-0 hx:top-0&#34;&gt;
  &lt;button
    class=&#34;hextra-code-copy-btn hx:group/copybtn hx:cursor-pointer hx:transition-all hx:active:opacity-50 hx:bg-primary-700/5 hx:border hx:border-black/5 hx:text-gray-600 hx:hover:text-gray-900 hx:rounded-md hx:p-1.5 hx:dark:bg-primary-300/10 hx:dark:border-white/10 hx:dark:text-gray-400 hx:dark:hover:text-gray-50&#34;
    title=&#34;Copy code&#34;
    aria-label=&#34;Copy code&#34;
    data-copied-label=&#34;Copied!&#34;
  &gt;
    &lt;div class=&#34;hextra-copy-icon hx:group-[.copied]/copybtn:hidden hx:pointer-events-none hx:h-4 hx:w-4&#34;&gt;&lt;/div&gt;
&lt;div class=&#34;hextra-success-icon hx:hidden hx:group-[.copied]/copybtn:block hx:pointer-events-none hx:h-4 hx:w-4&#34;&gt;&lt;/div&gt;
  &lt;/button&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;h2&gt;Khi nào dùng BMAD?&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;khi-nào-dùng-bmad&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#khi-n%c3%a0o-d%c3%b9ng-bmad&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;YES&lt;/strong&gt; — Project phức tạp, cần planning kỹ&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;YES&lt;/strong&gt; — Team muốn structured workflow&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;NO&lt;/strong&gt; — Project nhỏ, quick prototype&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;NO&lt;/strong&gt; — Team chưa quen với AI-assisted development&lt;/li&gt;
&lt;/ul&gt;

      </description>
